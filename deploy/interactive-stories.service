[Unit]
Description=Interactive Stories FastAPI Server
After=network.target

[Service]
Type=simple
User=stories
WorkingDirectory=/opt/interactive-stories/backend
EnvironmentFile=/opt/interactive-stories/backend/.env
ExecStart=/opt/interactive-stories/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
